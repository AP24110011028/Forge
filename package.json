    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.82.0",
